{
  "name": "autosonglink-chrome",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "package": "bun run build && bun scripts/package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/manrope": "5.3.0",
    "@types/bun": "1.4.2",
    "@types/chrome": "0.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
